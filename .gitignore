# ============================================
# Comparative-Study-on-the-Development-Paths-of-US-Soviet-Cooperative-Engagement-Systems .gitignore
# ============================================

# --- 操作系统 ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
S-1-5-21-*/
*.lnk

# Linux
*~
*.swp
*.swo
.*.swp
.directory

# --- 编辑器 / IDE ---
# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim
*.un~
*.bak
*.orig

# --- 文档临时文件 ---
# Word 临时文件
~$*.docx
~$*.doc
*.tmp
*.temp

# PDF 临时文件
*.pdf~

# --- 依赖与构建产物 ---
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo

# --- 大型文件（避免提交） ---
# 如果论文中有大型图表文件，可在此排除
# *.png
# *.jpg
# *.pdf

# --- 环境变量与敏感信息 ---
.env
.env.local

# --- 其他 ---
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
